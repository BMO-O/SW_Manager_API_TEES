{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "STAR WARS CHARACTERS API",
    "description": "API PARA GERENCIAMENTO DE PERSONAGENS DO UNIVERSO STAR WARS, DESENVOLVIDA COMO PROJETO PARA TEES (UFF-2026/2)"
  },
  "servers": [
    {
      "url": "http://localhost:3333/api/v1/characters",
      "description": "SERVIDOR LOCAL"
    }
  ],
  "tags": [
    {
      "name": "Characters",
      "description": "ENDPOINTS DE GERENCIAMENTO DE PERSONAGENS DO UNIVERSO STAR WARS"
    }
  ],
  "paths": {
    "/stats": {
      "get": {
        "tags": [
          "Characters"
        ],
        "summary": "CONSULTA ESTATÍSTICAS DO CATÁLOGO",
        "description": "RETORNA A QUANTIDADE TOTAL DE PERSONAGENS E A DISTRIBUIÇÃO POR RAÇA, CLASSE E ALIANÇA.",
        "responses": {
          "200": {
            "description": "ESTATÍSTICAS RETORNADAS COM SUCESSO.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CharacterStats"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/CharacterStats"
                }
              }
            }
          },
          "500": {
            "description": "ERRO INTERNO DO SERVIDOR.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/swapi/search": {
      "get": {
        "tags": [
          "Characters"
        ],
        "summary": "CONSULTA UM PERSONAGEM NA SWAPI OFICIAL",
        "description": "CONSOME O GATEWAY EXTERNO (BOUNDARY LAYER) PARA BUSCAR DADOS OFICIAIS DE UM PERSONAGEM DIRETAMENTE NA SWAPI (STAR WARS API). NÃO CONSULTA O BANCO DE DADOS LOCAL.",
        "parameters": [
          {
            "name": "nome",
            "in": "query",
            "description": "NOME (OU PARTE DO NOME) DO PERSONAGEM A SER BUSCADO NA SWAPI.",
            "required": true,
            "example": "LUKE",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PERSONAGEM ENCONTRADO NA SWAPI.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalCharacterDetails"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalCharacterDetails"
                }
              }
            }
          },
          "400": {
            "description": "PARÂMETRO NOME INVÁLIDO OU AUSENTE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "NENHUM PERSONAGEM ENCONTRADO NA SWAPI COM O NOME INFORMADO.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "SERVIÇO EXTERNO DA SWAPI INDISPONÍVEL OU TIMEOUT.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Characters"
        ],
        "summary": "LISTA OS PERSONAGENS",
        "description": "RETORNA OS PERSONAGENS CADASTRADOS, DE FORMA PAGINADA. PODE RECEBER NOME, CLASSE, RAÇA E ALIANÇA COMO FILTROS, ALÉM DE PAGE E LIMIT.",
        "parameters": [
          {
            "name": "nome",
            "in": "query",
            "description": "FILTRA PELO NOME (BUSCA PARCIAL).",
            "example": "LUKE",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "raca",
            "in": "query",
            "description": "FILTRA PELA RAÇA.",
            "example": "HUMANO",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "classe",
            "in": "query",
            "description": "FILTRA PELA CLASSE.",
            "example": "JEDI",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "alianca",
            "in": "query",
            "description": "FILTRA PELA ALIANÇA.",
            "example": "REBELDE",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "NÚMERO DA PÁGINA (PADRÃO: 1).",
            "example": 1,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "ITENS POR PÁGINA (PADRÃO: 10, MÁXIMO: 50).",
            "example": 10,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "LISTA PAGINADA DE PERSONAGENS.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedCharacters"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedCharacters"
                }
              }
            }
          },
          "400": {
            "description": "PARÂMETROS DE BUSCA INVÁLIDOS.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "ERRO INTERNO DO SERVIDOR.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Characters"
        ],
        "summary": "CADASTRA UM PERSONAGEM",
        "description": "",
        "responses": {
          "201": {
            "description": "PERSONAGEM CADASTRADO COM SUCESSO."
          },
          "400": {
            "description": "DADOS INVÁLIDOS.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "PERSONAGEM COM ESTE ID JÁ EXISTE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCharacterDTO"
              }
            }
          }
        }
      }
    },
    "/{id}": {
      "get": {
        "tags": [
          "Characters"
        ],
        "summary": "BUSCA UM PERSONAGEM POR ID",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "1"
          }
        ],
        "responses": {
          "200": {
            "description": "PERSONAGEM ENCONTRADO.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Character"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Character"
                }
              }
            }
          },
          "404": {
            "description": "PERSONAGEM NÃO ENCONTRADO.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Characters"
        ],
        "summary": "ATUALIZA UM PERSONAGEM",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "1"
          }
        ],
        "responses": {
          "200": {
            "description": "PERSONAGEM ATUALIZADO COM SUCESSO."
          },
          "404": {
            "description": "PERSONAGEM NÃO ENCONTRADO.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCharacterDTO"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Characters"
        ],
        "summary": "EXCLUI UM PERSONAGEM",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "1"
          }
        ],
        "responses": {
          "204": {
            "description": "PERSONAGEM EXCLUÍDO COM SUCESSO."
          },
          "404": {
            "description": "PERSONAGEM NÃO ENCONTRADO.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/{id}/evolve": {
      "patch": {
        "tags": [
          "Characters"
        ],
        "summary": "EVOLUI A CLASSE DE UM PERSONAGEM",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "1"
          }
        ],
        "responses": {
          "200": {
            "description": "CLASSE EVOLUÍDA COM SUCESSO."
          },
          "400": {
            "description": "TRANSIÇÃO DE CLASSE INVÁLIDA.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "PERSONAGEM NÃO ENCONTRADO.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvolveCharacterClassDTO"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CharacterRace": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "string"
          },
          "enum": {
            "type": "array",
            "example": [
              "HUMANO",
              "TWILEK",
              "TOGRUTA",
              "WOOKIEE",
              "ZABRAK",
              "RODIANO",
              "MON_CALAMARI",
              "DATHOMIRIANO",
              "DROIDE"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "xml": {
          "name": "CharacterRace"
        }
      },
      "CharacterClass": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "string"
          },
          "enum": {
            "type": "array",
            "example": [
              "JEDI",
              "MESTRE_JEDI",
              "SITH",
              "LORDE_SITH",
              "USUARIO_DA_FORCA",
              "SOLDADO",
              "OFICIAL",
              "COMANDANTE",
              "SENADOR",
              "DIPLOMATA",
              "CHANCELER",
              "REI",
              "CAVALEIRO_DE_REN",
              "CONTRABANDISTA",
              "PILOTO",
              "CIVIL"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "xml": {
          "name": "CharacterClass"
        }
      },
      "CharacterAlliance": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "string"
          },
          "enum": {
            "type": "array",
            "example": [
              "REPUBLICA",
              "SEPARATISTA",
              "IMPERIO",
              "REBELDE",
              "ORDEM_JEDI",
              "ORDEM_SITH",
              "PRIMEIRA_ORDEM",
              "RESISTENCIA",
              "CAVALEIROS_DE_REN"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "xml": {
          "name": "CharacterAlliance"
        }
      },
      "Character": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1"
          },
          "nome": {
            "type": "string",
            "example": "LUKE SKYWALKER"
          },
          "raca": {
            "type": "string",
            "example": "HUMANO"
          },
          "classes": {
            "type": "array",
            "example": [
              "JEDI"
            ],
            "items": {
              "type": "string"
            }
          },
          "aliancas": {
            "type": "array",
            "example": [
              "REBELDE",
              "ORDEM_JEDI"
            ],
            "items": {
              "type": "string"
            }
          },
          "planetaNatal": {
            "type": "string",
            "example": "TATOOINE"
          }
        },
        "xml": {
          "name": "Character"
        }
      },
      "CreateCharacterDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1"
          },
          "nome": {
            "type": "string",
            "example": "LUKE SKYWALKER"
          },
          "raca": {
            "type": "string",
            "example": "HUMANO"
          },
          "classes": {
            "type": "array",
            "example": [
              "JEDI"
            ],
            "items": {
              "type": "string"
            }
          },
          "aliancas": {
            "type": "array",
            "example": [
              "REBELDE",
              "ORDEM_JEDI"
            ],
            "items": {
              "type": "string"
            }
          },
          "planetaNatal": {
            "type": "string",
            "example": "TATOOINE"
          }
        },
        "required": [
          "id",
          "nome",
          "raca",
          "classes",
          "aliancas",
          "planetaNatal"
        ],
        "xml": {
          "name": "CreateCharacterDTO"
        }
      },
      "UpdateCharacterDTO": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "LUKE SKYWALKER (MESTRE JEDI)"
          },
          "raca": {
            "type": "string",
            "example": "HUMANO"
          },
          "classes": {
            "type": "array",
            "example": [
              "JEDI",
              "MESTRE_JEDI"
            ],
            "items": {
              "type": "string"
            }
          },
          "aliancas": {
            "type": "array",
            "example": [
              "REBELDE",
              "ORDEM_JEDI"
            ],
            "items": {
              "type": "string"
            }
          },
          "planetaNatal": {
            "type": "string",
            "example": "DAGOBAH"
          }
        },
        "xml": {
          "name": "UpdateCharacterDTO"
        }
      },
      "EvolveCharacterClassDTO": {
        "type": "object",
        "properties": {
          "fromClass": {
            "type": "string",
            "example": "USUARIO_DA_FORCA"
          },
          "toClass": {
            "type": "string",
            "example": "JEDI"
          }
        },
        "xml": {
          "name": "EvolveCharacterClassDTO"
        }
      },
      "PaginatedCharacters": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "example": "1"
                },
                "nome": {
                  "type": "string",
                  "example": "LUKE SKYWALKER"
                },
                "raca": {
                  "type": "string",
                  "example": "HUMANO"
                },
                "classes": {
                  "type": "array",
                  "example": [
                    "JEDI"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "aliancas": {
                  "type": "array",
                  "example": [
                    "REBELDE",
                    "ORDEM_JEDI"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "planetaNatal": {
                  "type": "string",
                  "example": "TATOOINE"
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "page": {
                "type": "number",
                "example": 1
              },
              "limit": {
                "type": "number",
                "example": 10
              },
              "total": {
                "type": "number",
                "example": 1
              }
            }
          }
        },
        "xml": {
          "name": "PaginatedCharacters"
        }
      },
      "ExternalCharacterDetails": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Luke Skywalker"
          },
          "heightCm": {
            "type": "number",
            "example": 172
          },
          "massKg": {
            "type": "number",
            "example": 77
          },
          "hairColor": {
            "type": "string",
            "example": "blond"
          },
          "eyeColor": {
            "type": "string",
            "example": "blue"
          },
          "birthYear": {
            "type": "string",
            "example": "19BBY"
          },
          "gender": {
            "type": "string",
            "example": "male"
          },
          "filmsCount": {
            "type": "number",
            "example": 4
          }
        },
        "xml": {
          "name": "ExternalCharacterDetails"
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "PERSONAGEM NÃO ENCONTRADO."
          }
        },
        "xml": {
          "name": "ErrorResponse"
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "DADOS DE ENTRADA INVÁLIDOS."
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "example": "nome"
                },
                "message": {
                  "type": "string",
                  "example": "O NOME DEVE TER NO MÍNIMO 2 CARACTERES"
                }
              }
            }
          }
        },
        "xml": {
          "name": "ValidationErrorResponse"
        }
      },
      "CharacterStats": {
        "type": "object",
        "properties": {
          "totalCharacters": {
            "type": "number",
            "example": 3
          },
          "racesCount": {
            "type": "object",
            "properties": {
              "HUMANO": {
                "type": "number",
                "example": 2
              },
              "TOGRUTA": {
                "type": "number",
                "example": 1
              }
            }
          },
          "classesCount": {
            "type": "object",
            "properties": {
              "JEDI": {
                "type": "number",
                "example": 2
              },
              "SITH": {
                "type": "number",
                "example": 1
              },
              "PILOTO": {
                "type": "number",
                "example": 1
              },
              "USUARIO_DA_FORCA": {
                "type": "number",
                "example": 2
              }
            }
          },
          "alliancesCount": {
            "type": "object",
            "properties": {
              "REBELDE": {
                "type": "number",
                "example": 2
              },
              "IMPERIO": {
                "type": "number",
                "example": 1
              },
              "ORDEM_JEDI": {
                "type": "number",
                "example": 1
              },
              "ORDEM_SITH": {
                "type": "number",
                "example": 1
              },
              "REPUBLICA": {
                "type": "number",
                "example": 1
              }
            }
          }
        },
        "xml": {
          "name": "CharacterStats"
        }
      }
    }
  }
}